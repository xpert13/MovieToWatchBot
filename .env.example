# --- Required -----------------------------------------------------------------
# From @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# From https://www.themoviedb.org/settings/api - either the "API Key" or the "API Read Access Token" works.
TMDB_API_KEY=

# --- Recommended --------------------------------------------------------------
# From https://www.omdbapi.com/apikey.aspx (FREE plan, 1,000 requests/day). Needed for the IMDb rating;
# without it the bot shows the TMDB rating instead.
OMDB_API_KEY=

# --- Optional -----------------------------------------------------------------
# Only react in these chats (comma separated). The bot logs the id of every chat it sees, e.g. -1001234567890.
# Empty = react everywhere the bot is added (and in private chats with it).
ALLOWED_CHAT_IDS=
# Language of titles and descriptions, e.g. en-US, uk-UA. Missing translations fall back to English.
LANGUAGE=en-US
# How many cards to post at most when several movies have the same name.
MAX_RESULTS=3
# Also look for TV series, not only movies.
INCLUDE_TV=true
# Delete your original message once the card(s) are posted (the bot needs the "Delete messages" admin right).
DELETE_ORIGINAL=false
LOG_LEVEL=INFO
